# Токен бота MAX (выдают организаторы)
BOT_TOKEN=

# PostgreSQL
POSTGRES_DB=startup_discovery
POSTGRES_USER=startup
POSTGRES_PASSWORD=

# YandexGPT — нужен для Idea Check, методики задач и AI Match.
# Без ключа приложение работает в запасном режиме (карта по правилам, подбор без оценки ИИ).
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# Режим отладки мини-аппа в обычном браузере (?debug_user=1).
# Только для тестов! Для сдачи должно быть false.
API_DEBUG_AUTH=false

# Тестовые учётные записи для автоматической проверки API (DATA-API.yaml).
# Заголовок X-Test-Token открывает только тестового основателя (id 910000000001)
# и тестового кандидата (id 910000000002). Пусто — вход по токену выключен.
# Сгенерировать: python3 -c "import secrets; print(secrets.token_hex(24))"  (в Windows: python)
API_TEST_TOKEN_FOUNDER=
API_TEST_TOKEN_CANDIDATE=
